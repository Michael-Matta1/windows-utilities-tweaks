<Window x:Class="WindowsTweakLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsTweakLauncher"
        xmlns:models="clr-namespace:WindowsTweakLauncher.Models"
        Title="Windows Tweaks Launcher"
        Width="1000" Height="750"
        MinWidth="800" MinHeight="600"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:NotGuideOnlyConverter x:Key="NotGuideOnlyConverter"/>

        <Style TargetType="Button" x:Key="AccentButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A8AD4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="DarkTextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="DarkCheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Name="ContentSite"
                                      Grid.Column="0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="6,0,0,0"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                    <Path Name="Arrow"
                          Grid.Column="1"
                          Data="M0,0 L6,0 L3,4 Z"
                          Fill="White"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="DarkComboBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="PART_ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Name="DropDownBorder"
                                        Background="#2A2A2A"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Name="ScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Padding="1"
                                                  BorderThickness="0"
                                                  Background="Transparent">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TweakItemTemplate">
            <Border Background="{StaticResource CardBackground}"
                    Margin="0,0,0,2"
                    Padding="6,4"
                    CornerRadius="3"
                    PreviewMouseLeftButtonUp="SelectTweakName_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding Strategy, Converter={StaticResource NotGuideOnlyConverter}}"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              ToolTip="Disabled for guide-only tweaks (use the detail panel instead)"/>

                    <Ellipse Grid.Column="1"
                             Width="10" Height="10"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource UnknownBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TweakStatus.Applied}">
                                        <Setter Property="Fill" Value="{StaticResource AppliedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TweakStatus.NotApplied}">
                                        <Setter Property="Fill" Value="{StaticResource NotAppliedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TweakStatus.PartialApplied}">
                                        <Setter Property="Fill" Value="{StaticResource PartialBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TweakStatus.Reapplicable}">
                                        <Setter Property="Fill" Value="{StaticResource ReapplicableBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Name}"
                               Foreground="White"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Cursor="Hand">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Id}" Value="hide_context_menu_items">
                                        <Setter Property="ToolTip" Value="Select then click Apply to hide all items, or Revert to restore all items"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Id}" Value="explorer_cmd">
                                        <Setter Property="ToolTip" Value="Select then click Apply to copy all .bat files, or Revert to restore them from backup"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Id}" Value="terminal_profiles">
                                        <Setter Property="ToolTip" Value="Select then click Apply to add all profiles, or Revert to remove them"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Id}" Value="markdown_ctx">
                                        <Setter Property="ToolTip" Value="Select then click Apply with default settings (Create Markdown File, .md), or Revert to remove"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Id}" Value="new_txt_file">
                                        <Setter Property="ToolTip" Value="Select then click Apply with default settings (Basic Version, Ctrl+Alt+N), or Revert to remove"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Id}" Value="hw_identity">
                                        <Setter Property="ToolTip" Value="Select then click Apply to spoof Samsung hardware identity (default), or Revert to restore original BIOS values"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <GroupStyle x:Key="CategoryGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,8,0,2"
                                   FontSize="13"/>
                        <Rectangle Grid.Row="1" Height="1" Fill="#333333" Margin="0,0,0,4"/>
                    </Grid>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 1: Header -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="White"
                           Text="Windows Tweaks Launcher:"/>
                <TextBlock FontSize="14" FontWeight="Normal" Foreground="#CCE0FF"
                           Text=" Apply, revert, and explore Windows registry and script tweaks"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ROW 2: Repo path bar -->
        <Border Grid.Row="1" Background="#252525" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Repo:"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBox x:Name="RepoPathBox" Grid.Column="1"
                         Text="{Binding Settings.RepoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}"
                         ToolTip="Full path to the cloned windows-utilities-tweaks repository folder"
                         TextChanged="RepoPath_TextChanged"
                         LostFocus="RepoPath_LostFocus"/>

                <Button Grid.Column="2" Content="Browse…"
                        Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0"
                        ToolTip="Browse for the repository folder"
                        Click="BrowseRepoPath_Click"/>

                <Button Grid.Column="3" Content="⟳ Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0"
                        ToolTip="Re-check status of all tweaks"
                        Click="RefreshStatus_Click"/>
            </Grid>
        </Border>

        <!-- ROW 3: Safety options bar -->
        <Border Grid.Row="2" Background="#252525" Padding="12,6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="🛡 Back up registry"
                              IsChecked="{Binding Settings.BackupEnabled}"
                              Style="{StaticResource DarkCheckBox}"
                              VerticalAlignment="Center"
                              FontWeight="Bold"
                              ToolTip="Master toggle — when off, all backup phases are skipped"
                              Checked="BackupEnabled_Changed"
                              Unchecked="BackupEnabled_Changed"/>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BackupDirBox" Grid.Column="0"
                                 Text="{Binding Settings.BackupDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 ToolTip="Directory where registry backup .reg files are saved"
                                 VerticalAlignment="Center"
                                 TextChanged="BackupDir_TextChanged"
                                 LostFocus="BackupDir_LostFocus"/>

                        <Button Grid.Column="1" Content="Browse…"
                                Style="{StaticResource SecondaryButton}"
                                Margin="4,0,0,0"
                                Padding="8,2"
                                ToolTip="Browse for backup directory"
                                Click="BrowseBackupDir_Click"/>
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                    <CheckBox Content="Pre-apply"
                              IsChecked="{Binding Settings.BackupPreApply}"
                              IsEnabled="{Binding Settings.BackupEnabled}"
                              Style="{StaticResource DarkCheckBox}"
                              ToolTip="Back up registry keys BEFORE applying the tweak (saves previous state for rollback)"
                              Checked="BackupEnabled_Changed"
                              Unchecked="BackupEnabled_Changed"/>
                    <CheckBox Content="Post-apply"
                              IsChecked="{Binding Settings.BackupPostApply}"
                              IsEnabled="{Binding Settings.BackupEnabled}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="12,0,0,0"
                              ToolTip="Back up registry keys AFTER applying the tweak (captures the new state)"
                              Checked="BackupEnabled_Changed"
                              Unchecked="BackupEnabled_Changed"/>
                    <CheckBox Content="Pre-revert"
                              IsChecked="{Binding Settings.BackupPreRevert}"
                              IsEnabled="{Binding Settings.BackupEnabled}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="12,0,0,0"
                              ToolTip="Back up registry keys BEFORE reverting (saves the applied state before removal)"
                              Checked="BackupEnabled_Changed"
                              Unchecked="BackupEnabled_Changed"/>
                    <CheckBox Content="Post-revert"
                              IsChecked="{Binding Settings.BackupPostRevert}"
                              IsEnabled="{Binding Settings.BackupEnabled}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="12,0,0,0"
                              ToolTip="Back up registry keys AFTER reverting (captures the new state after removal)"
                              Checked="BackupEnabled_Changed"
                              Unchecked="BackupEnabled_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ROW 4: Toolbar -->
        <Border Grid.Row="3" Background="#2A2A2A" Padding="12,6" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="✓ Select Preset Tweaks"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,4" Margin="0,0,6,0"
                        ToolTip="Auto-select all tweaks that can be applied automatically (skips guides and tweaks requiring input)"
                        Click="SelectAllScriptable_Click"/>

                <Button Grid.Column="1" Content="✗ Clear All"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,4" Margin="0,0,12,0"
                        ToolTip="Deselect all tweaks"
                        Click="ClearAll_Click"/>

                <TextBlock Grid.Column="2"
                           x:Name="SelectionCountText"
                           Text="0 selected"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"/>

                <Button Grid.Column="4"
                        x:Name="ApplySelectedButton"
                        Content="▶ Apply Selected (0)"
                        Style="{StaticResource AccentButton}"
                        FontWeight="Bold"
                        IsEnabled="False"
                        ToolTip="Apply all selected tweaks in sequence"
                        Click="ApplySelected_Click"/>
                <Button Grid.Column="5"
                        x:Name="RevertSelectedButton"
                        Content="↩ Revert Selected (0)"
                        Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0"
                        FontWeight="Bold"
                        IsEnabled="False"
                        ToolTip="Revert all selected tweaks that have been applied"
                        Click="RevertSelected_Click"/>
            </Grid>
        </Border>

        <!-- ROW 5: Main content -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Tweak list -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}"
                    BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Click a tweak below to see its options"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="4,4,4,0"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,4">
                        <ItemsControl x:Name="TweaksList"
                                      ItemTemplate="{StaticResource TweakItemTemplate}">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="CategoryGroupStyle"/>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Detail panel -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PlaceholderText"
                               Text="← Click any item in the left panel to view available options"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20,0"
                               Visibility="Visible"/>

                     <Grid Grid.Row="0" x:Name="DetailPanel" Visibility="Collapsed">
                          <Grid.RowDefinitions>
                              <RowDefinition Height="*"/>
                              <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                           <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                             <StackPanel>
                                 <TextBlock x:Name="DetailName" FontSize="18" FontWeight="Bold"
                                            Foreground="White" TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailDescription"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,12"
                                            FontSize="13"
                                            TextTrimming="CharacterEllipsis"/>

                                 <Border Background="#1E1E1E" Padding="10,6" CornerRadius="4" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Status: " Foreground="{StaticResource MutedTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="BackupInfoPanel" Background="#1E1E1E"
                                        Padding="10,6" CornerRadius="4" Margin="0,0,0,8">
                                    <TextBlock x:Name="BackupInfoText" TextWrapping="Wrap" FontSize="12"/>
                                </Border>

                                <Border x:Name="InputPanel" Background="#1E1E1E"
                                        Padding="10,8" CornerRadius="4" Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="InputLabel" Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="InputTextBox" Grid.Column="0"
                                                     Style="{StaticResource DarkTextBox}"
                                                     ToolTip="Enter the required value for this tweak"
                                                     TextChanged="InputTextBox_TextChanged"/>
                                            <Button x:Name="InputBrowseButton" Grid.Column="1" Content="Browse…"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Browse for a folder"
                                                    Click="InputBrowse_Click"/>
                                        </Grid>
                                        <ComboBox x:Name="InputComboBox"
                                                  Style="{StaticResource DarkComboBox}"
                                                  Visibility="Collapsed"
                                                  Margin="0,4,0,0"
                                                  ToolTip="Select a variant to apply"
                                                  SelectionChanged="InputComboBox_SelectionChanged"/>
                                        <StackPanel x:Name="HotkeyPanel" Visibility="Collapsed"
                                                     Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Hotkey:" Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="HotkeyTextBox"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="160"
                                                         ToolTip="Enter a hotkey combination (e.g. Ctrl+Shift+E). Note: the Windows key is not supported for shortcut hotkeys."
                                                         TextChanged="HotkeyTextBox_TextChanged"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="HwIdentityPanel" Visibility="Collapsed"
                                                     Margin="0,6,0,0">
                                            <TextBlock Text="Manufacturer:" Foreground="{StaticResource MutedTextBrush}"
                                                        Margin="0,0,0,4"/>
                                            <TextBox x:Name="ManufacturerTextBox"
                                                     Style="{StaticResource DarkTextBox}"
                                                     ToolTip="Enter the system manufacturer name for BIOS identification"
                                                     TextChanged="ManufacturerTextBox_TextChanged"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock Text="Product Name:" Foreground="{StaticResource MutedTextBrush}"
                                                         Margin="0,0,0,4"/>
                                            <TextBox x:Name="ProductNameTextBox"
                                                     Style="{StaticResource DarkTextBox}"
                                                     ToolTip="Enter the product name for BIOS identification"
                                                     TextChanged="ProductNameTextBox_TextChanged"/>
                                            <TextBlock Foreground="{StaticResource AmberBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Text="You must confirm the apply dialog. These values are written to HKLM\HARDWARE\DESCRIPTION\System\BIOS."/>
<TextBlock Text="Quick presets:" Foreground="{StaticResource AccentBrush}"
                                                        FontWeight="SemiBold" FontSize="12"
                                                        Margin="0,4,0,2"/>
                                            <WrapPanel>
                                                <Button Content="Samsung" Tag="Samsung,NP960XFG-KC4UK" Click="HwPreset_Click"
                                                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"
                                                        ToolTip="Fill manufacturer + product with Samsung preset values"/>
                                                <Button Content="ASUS" Tag="ASUSTeK COMPUTER INC.,ZenBook UX425EA" Click="HwPreset_Click"
                                                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"
                                                        ToolTip="Fill manufacturer + product with ASUS preset values"/>
                                                <Button Content="Lenovo" Tag="Lenovo,20U9CTO1WW" Click="HwPreset_Click"
                                                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"
                                                        ToolTip="Fill manufacturer + product with Lenovo preset values"/>
                                                <Button Content="Dell" Tag="Dell Inc.,XPS 13 9310" Click="HwPreset_Click"
                                                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"
                                                        ToolTip="Fill manufacturer + product with Dell preset values"/>
                                                <Button Content="HP" Tag="HP,HP ENVY Laptop 13-ba1xxx" Click="HwPreset_Click"
                                                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"
                                                        ToolTip="Fill manufacturer + product with HP preset values"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Markdown Creator settings - only shown for markdown_ctx tweak -->
                                <StackPanel x:Name="MarkdownCtxPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Custom File Creator Settings:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Background="#1E1E1E" Padding="10,8" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Context menu name:" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="MarkdownCtxMenuName" Text="Create Markdown File"
                                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"
                                                     ToolTip="Name that appears in the right-click context menu"
                                                     TextChanged="MarkdownCtxMenuName_TextChanged"/>
                                            <TextBlock Text="File extension:" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="MarkdownCtxExtension" Text=".md"
                                                     Style="{StaticResource DarkTextBox}"
                                                     ToolTip="File extension for the new file (e.g. .md, .txt)"
                                                     TextChanged="MarkdownCtxExtension_TextChanged"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0">
                                                    Revert tip: To revert, enter the exact same menu name and extension you applied before, then click Revert.</TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Special Folders quick-open buttons - only shown for special_folders tweak -->
                                <StackPanel x:Name="SpecialFoldersPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Quick-open a Special Folder:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button Content="All Installed Applications" Tag="shell:AppsFolder" Click="OpenShellFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the All Apps folder (shell:AppsFolder)"/>
                                        <Button Content="Startup (Current User)" Tag="shell:startup" Click="OpenShellFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the current user's Startup folder"/>
                                        <Button Content="Startup (All Users)" Tag="shell:common startup" Click="OpenShellFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the All Users Startup folder"/>
                                        <Button Content="Start Menu (Current User)" Tag="shell:programs" Click="OpenShellFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the current user's Start Menu programs folder"/>
                                        <Button Content="Start Menu (All Users)" Tag="shell:common programs" Click="OpenShellFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the All Users Start Menu programs folder"/>
                                        <Button Content="Send To Menu" Tag="shell:sendto" Click="OpenShellFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the Send To menu folder"/>
                                        <Button Content="Taskbar Pinned Items" Click="OpenTaskbarPins_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Open the taskbar pinned items folder"/>
                                        <Button Content="Create GodMode Folder on Desktop" Click="CreateGodMode_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Create a GodMode control panel folder on the desktop"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Terminal Profiles preset buttons - only shown for terminal_profiles tweak -->
                                <StackPanel x:Name="TerminalProfilesPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Add a Terminal Profile:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="TermProfileIseDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="TermProfileIse" Content="PowerShell ISE" Style="{StaticResource DarkCheckBox}" ToolTip="Add PowerShell ISE as a profile in Windows Terminal"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="TermProfileGitBashDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="TermProfileGitBash" Content="Git Bash" Style="{StaticResource DarkCheckBox}" ToolTip="Add Git Bash as a profile in Windows Terminal"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="ShortcutProfilesPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Create a Taskbar Shortcut:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Presets:" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="Add OCR Shortcut" Click="ShortcutAddOcr_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Create a shortcut for PowerToys Text Extractor (Win+Shift+T) and pin it to the taskbar"/>
                                        <Button Content="Add Voice Typing Shortcut" Click="ShortcutAddVoiceTyping_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Create a shortcut for Windows Voice Typing (Win+H) and pin it to the taskbar"/>
                                    </WrapPanel>
                                    <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Custom Keybinding:" Foreground="#CCC" FontSize="12" Margin="0,0,0,3"/>
                                            <WrapPanel>
                                                <TextBox x:Name="CustomShortcutKeys" Width="260" Text="Ctrl+Shift+Esc" Style="{StaticResource DarkTextBox}" Margin="0,0,6,4" ToolTip="Enter the keyboard shortcut combination to simulate (e.g. Ctrl+Shift+Esc, Win+E)" TextChanged="CustomShortcutKeys_TextChanged"/>
                                                <Button Content="Create Custom Keybinding" Click="ShortcutAddCustom_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4" ToolTip="Generate scripts, create a shortcut, and pin it to the taskbar for the custom keybinding"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" Padding="6" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Icon file (optional):" Foreground="#CCC" FontSize="12" Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ShortcutIconPath" Grid.Column="0" Style="{StaticResource DarkTextBox}" ToolTip="Full path to a .ico file to use as the shortcut icon"/>
                                                <Button Grid.Column="1" Content="Browse..." Click="BrowseShortcutIcon_Click" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" ToolTip="Browse for a .ico icon file"/>
                                            </Grid>
                                            <TextBlock Text="Should be a .ico file. If left empty, the shortcut will use the default icon." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="ExplorerCmdPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Explorer Address Bar Shortcuts (copied to C:\\Windows):" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="ExpCmdAcmdDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="ExpCmdAcmd" Content="acmd.bat — Admin Command Prompt" Style="{StaticResource DarkCheckBox}" ToolTip="Copy acmd.bat to C:\Windows to launch Admin Command Prompt from Explorer address bar"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="ExpCmdApsDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="ExpCmdAps" Content="aps.bat — Admin PowerShell" Style="{StaticResource DarkCheckBox}" ToolTip="Copy aps.bat to C:\Windows to launch Admin PowerShell from Explorer address bar"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="ExpCmdAtrDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="ExpCmdAtr" Content="atr.bat — Admin Terminal" Style="{StaticResource DarkCheckBox}" ToolTip="Copy atr.bat to C:\Windows to launch Admin Terminal from Explorer address bar"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Context Menu Items batch panel - shown for Remove or Disable Context Menu Items folder -->
                                <StackPanel x:Name="ContextMenuItemsPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock Text="Hide Context Menu Items:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="4,4,4,2">
                                        <Button Content="✓ Select All" Click="ContextMenuSelectAll_Click" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0" ToolTip="Check all context menu items"/>
                                        <Button Content="✗ Clear All" Click="ContextMenuClearAll_Click" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" ToolTip="Uncheck all context menu items"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="CtxHideCastToDeviceDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="CtxHideCastToDevice" Content="Cast to Device" Style="{StaticResource DarkCheckBox}" ToolTip="Hide the 'Cast to Device' entry from the right-click context menu"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="CtxHideShareDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="CtxHideShare" Content="Share" Style="{StaticResource DarkCheckBox}" ToolTip="Hide the 'Share' entry from the right-click context menu"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="CtxHideGiveAccessToDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="CtxHideGiveAccessTo" Content="Give Access To" Style="{StaticResource DarkCheckBox}" ToolTip="Hide the 'Give Access To' entry from the right-click context menu"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="CtxHidePaint3DDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="CtxHidePaint3D" Content="Edit with Paint 3D" Style="{StaticResource DarkCheckBox}" ToolTip="Hide the 'Edit with Paint 3D' entry from the right-click context menu"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="CtxHideEditPhotosDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="CtxHideEditPhotos" Content="Edit with Photos" Style="{StaticResource DarkCheckBox}" ToolTip="Hide the 'Edit with Photos' entry from the right-click context menu"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Ellipse x:Name="CtxHideDefenderScanDot" Width="8" Height="8" Fill="{StaticResource AppliedBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="CtxHideDefenderScan" Content="Scan with Windows Defender" Style="{StaticResource DarkCheckBox}" ToolTip="Hide the 'Scan with Windows Defender' entry from the right-click context menu"/>
                                    </StackPanel>
                                    <TextBlock Text="⟳ Restart Explorer after applying/restoring for changes to take effect."
                                               Foreground="{StaticResource AmberBrush}"
                                               FontSize="11" FontStyle="Italic"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                   </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                      <Button x:Name="ApplyButton" Content="Apply"
                                              Style="{StaticResource AccentButton}" Margin="0,0,6,0" IsEnabled="False"
                                              ToolTip="Apply the currently selected tweak"
                                              Click="ApplyTweak_Click"/>
                                      <Button x:Name="RevertButton" Content="Revert"
                                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" IsEnabled="False"
                                              ToolTip="Revert the currently selected tweak (if previously applied)"
                                              Click="RevertTweak_Click"/>
                                      <Button x:Name="CtxMenuApplyBtn" Content="✓ Apply Checked"
                                              Style="{StaticResource AccentButton}" Margin="0,0,6,0" FontWeight="Bold"
                                              Visibility="Collapsed" Click="ContextMenuHide_Click"
                                              ToolTip="Block the checked context menu items in the registry"/>
                                      <Button x:Name="CtxMenuRestoreBtn" Content="↩ Restore Checked"
                                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                              Visibility="Collapsed" Click="ContextMenuRestore_Click"
                                              ToolTip="Unblock the checked context menu items in the registry"/>
                                      <Button x:Name="TermProfilesApplyBtn" Content="✓ Apply Checked"
                                              Style="{StaticResource AccentButton}" Margin="0,0,6,0" FontWeight="Bold"
                                              Visibility="Collapsed" Click="TerminalProfilesApply_Click"
                                              ToolTip="Add the checked profiles to Windows Terminal"/>
                                      <Button x:Name="TermProfilesRestoreBtn" Content="↩ Restore Checked"
                                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                              Visibility="Collapsed" Click="TerminalProfilesRestore_Click"
                                              ToolTip="Remove the checked profiles from Windows Terminal"/>
                                      <Button x:Name="ExpCmdApplyBtn" Content="✓ Apply Checked"
                                              Style="{StaticResource AccentButton}" Margin="0,0,6,0" FontWeight="Bold"
                                              Visibility="Collapsed" Click="ExplorerCmdApply_Click"
                                              ToolTip="Copy the checked .bat files to C:\Windows"/>
                                      <Button x:Name="ExpCmdRestoreBtn" Content="↩ Restore Checked"
                                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                              Visibility="Collapsed" Click="ExplorerCmdRestore_Click"
                                              ToolTip="Restore the checked .bat files in C:\Windows from their backups"/>
                                      <Button x:Name="OpenFolderButton" Content="Open Folder in Explorer"
                                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                              ToolTip="Open the tweak's source folder in Windows Explorer"
                                              Click="OpenFolder_Click"/>
                                      <Button x:Name="ManualGuideButton" Content="Open Guide (GitHub)"
                                              Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                              ToolTip="Open the guide page for this tweak on GitHub"
                                              Click="ViewManualGuide_Click"/>
                                      <Button x:Name="RestartExplorerButton" Content="⟳ Restart Explorer"
                                              Style="{StaticResource SecondaryButton}"
                                              Visibility="Collapsed"
                                              ToolTip="Restart Windows Explorer to apply changes"
                                              Click="RestartExplorer_Click"/>
                                  </StackPanel>
                             </StackPanel>
                         </ScrollViewer>

                             <Border Grid.Row="1" Background="{StaticResource LogBackground}"
                                     CornerRadius="4" Margin="0,8,0,0"
                                     Padding="8,4" Height="100">
                                 <DockPanel>
                                     <Button Content="✕ Clear"
                                             Style="{StaticResource SecondaryButton}"
                                             Background="#4A2A2A"
                                             BorderBrush="#6A3A3A"
                                             HorizontalAlignment="Right"
                                             DockPanel.Dock="Top"
                                             Margin="0,0,0,4"
                                             Padding="6,1"
                                             FontSize="11"
                                             ToolTip="Clear the operation log"
                                             Click="ClearLog_Click"/>
                                     <TextBox x:Name="LogBox"
                                              Background="Transparent"
                                              Foreground="{StaticResource LogForeground}"
                                              BorderThickness="0"
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              IsReadOnly="True"
                                              TextWrapping="Wrap"
                                              VerticalScrollBarVisibility="Auto"
                                              Text="Operation log — output from Apply/Revert will appear here."/>
                                 </DockPanel>
                             </Border>
                         </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 6: Footer -->
        <Border Grid.Row="5" Background="#1A1A1A" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterText"
                           Text="Ready"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Visit Source Repository"
                        Style="{StaticResource AccentButton}"
                        Padding="14,4" FontSize="12"
                        ToolTip="Open the GitHub repository for this project"
                        Click="VisitSource_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
